PORT=4000
USE_MEMORY_MONGO=true
MONGODB_URI=mongodb://localhost:27017/proxo-vpn
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NODE_AGENT_SECRET=change-me-node-agent-secret
DEFAULT_AGENT_URL=http://127.0.0.1:4100
ALLOW_CONNECT_WITHOUT_AGENT=true
# Browser extension HTTP CONNECT proxy port advertised by /v1/browser/connect
HTTP_PROXY_PORT=8080
# Set true in production (or leave unset — seeds auto-hide once a real node is registered)
# HIDE_SEED_SERVERS=true

# Billing
ALLOW_DEV_BILLING=true
REVENUECAT_WEBHOOK_SECRET=change-me-revenuecat-webhook
STRIPE_WEBHOOK_SECRET=
ADMIN_API_KEY=horse-admin-dev

# Production (Heroku): see .env.production.example and docs/DEPLOY_API_HEROKU.md
# USE_MEMORY_MONGO=false
# MONGODB_URI=mongodb+srv://...
# CORS_ORIGINS=*

