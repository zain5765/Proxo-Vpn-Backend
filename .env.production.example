# Copy these into Heroku config vars (Dashboard → Settings → Config Vars)
# or: heroku config:set KEY=value -a YOUR_APP

PORT=4000
USE_MEMORY_MONGO=false
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/horse-vpn?retryWrites=true&w=majority
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=*
NODE_AGENT_SECRET=replace-with-same-secret-as-vps-agent
DEFAULT_AGENT_URL=http://YOUR_VPS_IP:4100
ALLOW_CONNECT_WITHOUT_AGENT=false
ALLOW_DEV_BILLING=false
ADMIN_API_KEY=replace-with-admin-key
REVENUECAT_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
